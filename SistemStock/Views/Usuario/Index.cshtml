@model IEnumerable<SistemStock.Models.ViewModels.Usuario.UsuarioViewModel>
@{
    ViewData["Title"] = "Usuarios";
    ViewData["SubTitle"] = "Listado de Usuarios";
}

@if (TempData["Ok"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Ok"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-end align-items-center mb-3">
    <a asp-action="Crear" class="btn btn-sm btn-outline-primary" title="Crear">
        <i class="bi bi-plus"></i> Nuevo Usuario
    </a>
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle" id="miTabla">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Email</th>
                <th>Rol</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td>@u.Nombre</td>
                    <td>@u.Email</td>
                    <td><span class="badge text-bg-info">@u.Rol</span></td>
                    <td>
                        @if (u.Activo)
                        {
                            <span class="badge text-bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Inactivo</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Editar" asp-route-id="@u.Id"
                           class="btn btn-sm btn-outline-primary" title="Editar">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a asp-action="ResetearPassword" asp-route-id="@u.Id"
                           class="btn btn-sm btn-outline-warning" title="Resetear contraseña">
                            <i class="bi bi-key"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
