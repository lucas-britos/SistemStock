@model IEnumerable<SistemStock.Models.ViewModels.ProductoViewModel>
@{
    ViewData["Title"] = "Productos";
}
<h1>@ViewData["Title"]</h1>

@if (TempData["Ok"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Ok"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Listado de Productos</h2>
    <a asp-action="Create" class="btn btn-primary">+ Nuevo Producto</a>
</div>

<form method="get" class="row mb-3">
    <div class="col-auto">
        <input type="text" name="buscar" class="form-control" placeholder="Buscar..." />
    </div>
    <div class="col-auto">
        <select name="buscarCategoria" class="form-select" asp-items="ViewBag.Categorias">
            <option value="">Todas las categorías</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-secondary">Buscar</button>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Codigo)</th>
            <th>@Html.DisplayNameFor(model => model.Nombre)</th>
            <th>@Html.DisplayNameFor(model => model.CategoriaNombre)</th>
            <th>@Html.DisplayNameFor(model => model.UnidadDeMedida)</th>
            <th>@Html.DisplayNameFor(model => model.PrecioCosto)</th>
            <th>@Html.DisplayNameFor(model => model.PrecioVenta)</th>
            <th>@Html.DisplayNameFor(model => model.StockTotal)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="8" class="text-center text-muted py-4">No se encontraron productos.</td>
            </tr>
        }
        @foreach (var item in Model)
        {
            <tr class="@(item.BajoStockMinimo ? "table-danger" : "")">
                <td>@Html.DisplayFor(modelItem => item.Codigo)</td>
                <td>@Html.DisplayFor(modelItem => item.Nombre)</td>
                <td>@Html.DisplayFor(modelItem => item.CategoriaNombre)</td>
                <td>@Html.DisplayFor(modelItem => item.UnidadDeMedida)</td>
                <td>@Html.DisplayFor(modelItem => item.PrecioCosto)</td>
                <td>@Html.DisplayFor(modelItem => item.PrecioVenta)</td>
                <td>
                    @item.StockTotal
                    @if (item.BajoStockMinimo)
                    {
                        <span class="badge bg-danger">Bajo mínimo</span>
                    }
                </td>
                <td width="220">
                    <a asp-action="Details" asp-route-id="@item.id" class="btn btn-sm btn-info">Ver</a>
                    <a asp-action="Edit" asp-route-id="@item.id" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.id" class="btn btn-sm btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
